{
  "compilerOptions": {
    "target": "ES2022",
    // Vite 的构建工具类型使用显式资源管理符号。
    // Vite's build tooling types use explicit resource management symbols.
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    // 由 TypeScript 检查类型，由 Vite 生成静态产物。
    // TypeScript checks types, and Vite emits the static build.
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "vite.config.ts"]
}
