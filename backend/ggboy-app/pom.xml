<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ggboy</groupId>
        <artifactId>ggboy-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ggboy-app</artifactId>

    <description>Solana DeFi indexer and query API</description>

    <properties>
        <!-- MyBatis API 和 Swagger 注解在编译与运行时均使用模块路径。
             Keep the MyBatis API and Swagger annotations on the module path at compile time and runtime. -->
        <library-module-artifacts>mybatis,mybatis-plus-core,mybatis-plus-annotation,mybatis-plus-extension,mybatis-plus-spring,swagger-annotations</library-module-artifacts>
        <!-- springdoc 与 Swagger 注解版本由同一个 BOM 管理。
             Manage springdoc and Swagger annotations with the same BOM. -->
        <springdoc.version>3.2.1</springdoc.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-bom</artifactId>
                <version>${springdoc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.ggboy</groupId>
            <artifactId>ggboy-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.ggboy</groupId>
            <artifactId>ggboy-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- 控制器使用 OpenAPI 注解，运行时由 springdoc 扫描并提供 Swagger UI。
             Controllers use OpenAPI annotations. At runtime, springdoc scans them and serves Swagger UI. -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Mapper 接口与注解参与模块编译，Starter 负责运行期自动配置。
             Compile against mapper interfaces and annotations; load starter auto-configuration at runtime. -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-core</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- 3.5.18 的 IService 和 ServiceImpl 由 Spring 集成库提供。
             Version 3.5.18 provides IService and ServiceImpl in the Spring integration library. -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 应用自身也是具名模块，与框架模块一起发布到 modules 目录。
                 Publish the application itself as a named module alongside the framework modules. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                            <excludes>
                                <exclude>db/migration/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <!-- Flyway 通过类路径读取 SQL。独立的资源 JAR 避免 JPMS 限制或重复发现同一次迁移。
                         Flyway reads SQL from the classpath. A resource-only JAR avoids JPMS access restrictions and duplicate discovery. -->
                    <execution>
                        <id>stage-flyway-migrations</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classifier>migrations</classifier>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includes>
                                <include>db/migration/*.sql</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- 项目模块和 Spring 的具名/自动模块进入 JPMS module path。
                         Place the project modules and Spring modules on the JPMS module path. -->
                    <execution>
                        <id>stage-module-path</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <includeGroupIds>io.ggboy,org.springframework,org.springframework.boot</includeGroupIds>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-library-modules</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <includeArtifactIds>${library-module-artifacts}</includeArtifactIds>
                            <outputDirectory>${project.build.directory}/modules</outputDirectory>
                        </configuration>
                    </execution>
                    <!-- MyBatis-Plus 自动配置包、springdoc 和 Swagger UI 静态资源从 classpath 加载。
                         Load MyBatis-Plus auto-configuration, springdoc and Swagger UI assets from the classpath. -->
                    <execution>
                        <id>stage-class-path</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <excludeArtifactIds>${library-module-artifacts}</excludeArtifactIds>
                            <excludeGroupIds>io.ggboy,org.springframework,org.springframework.boot</excludeGroupIds>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
